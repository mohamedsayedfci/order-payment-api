APP_NAME="Order Payment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite by default. For MySQL, set DB_CONNECTION=mysql
# and configure DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
JWT_SECRET=
JWT_TTL=60
JWT_ISSUER=order-payment-api
JWT_AUDIENCE=order-payment-client
CREDIT_CARD_ENABLED=true
CREDIT_CARD_API_KEY=
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
